+func TestNormalizeProbabilityJSON(t *testing.T) {
+	raw := `{"A: Alpha":0.3,"B: Beta":0.5}`
+	normalized, ok := normalizeProbabilityJSON(raw, []string{"A: Alpha", "B: Beta"})
+	if !ok {
+		t.Fatal("expected normalization")
+	}
+	var values map[string]float64
+	if err := json.Unmarshal([]byte(normalized), &values); err != nil {
+		t.Fatal(err)
+	}
+	if math.Abs(values["A: Alpha"]-0.375) > 1e-12 || math.Abs(values["B: Beta"]-0.625) > 1e-12 {
+		t.Fatalf("values %+v", values)
+	}
+	if _, ok := normalizeProbabilityJSON(`{"A: Alpha":0}`, []string{"A: Alpha", "B: Beta"}); ok {
+		t.Fatal("missing key must not normalize")
+	}
+}

