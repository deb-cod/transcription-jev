diff --git a/features/decision-test/internal/engine/ollama.go b/features/decision-test/internal/engine/ollama.go
new file mode 100644
index 0000000..5c1500c
--- /dev/null
+++ b/features/decision-test/internal/engine/ollama.go
@@ -0,0 +1,278 @@
+package engine
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"openjev/features/decision-test/internal/logger"
+	"openjev/features/decision-test/internal/prompt"
+)
+
+// OllamaClient implements Engine using Ollama's native chat API. Ollama does
+// not expose the option-token log probabilities required by OpenJev's direct
+// method, so this engine supports generation decisions only.
+type OllamaClient struct {
+	baseURL   string
+	model     string
+	keepAlive string
+	numCtx    int
+	http      *http.Client
+	log       *logger.Logger
+}
+
+func NewOllamaClient(baseURL, model, keepAlive string, numCtx, maxIdleConns int, log *logger.Logger) *OllamaClient {
+	if maxIdleConns < 1 {
+		maxIdleConns = 1
+	}
+	if keepAlive == "" {
+		keepAlive = "10m"
+	}
+	if numCtx < 1 {
+		numCtx = 4096
+	}
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.MaxIdleConnsPerHost = maxIdleConns
+	if transport.MaxIdleConns < maxIdleConns {
+		transport.MaxIdleConns = maxIdleConns
+	}
+	return &OllamaClient{
+		baseURL:   strings.TrimRight(baseURL, "/"),
+		model:     model,
+		keepAlive: keepAlive,
+		numCtx:    numCtx,
+		http:      &http.Client{Timeout: 10 * time.Minute, Transport: transport},
+		log:       log,
+	}
+}
+
+type ollamaChatBody struct {
+	Model     string           `json:"model"`
+	Messages  []prompt.Message `json:"messages"`
+	Stream    bool             `json:"stream"`
+	Format    any              `json:"format,omitempty"`
+	Think     bool             `json:"think"`
+	KeepAlive string           `json:"keep_alive"`
+	Options   struct {
+		Temperature float64 `json:"temperature"`
+		NumCtx      int     `json:"num_ctx"`
+	} `json:"options"`
+}
+
+type ollamaChatResponse struct {
+	Message struct {
+		Content string `json:"content"`
+	} `json:"message"`
+	PromptEvalCount int   `json:"prompt_eval_count"`
+	EvalCount       int   `json:"eval_count"`
+	TotalDuration   int64 `json:"total_duration"`
+}
+
+func (c *OllamaClient) ReadLabelLogprobs(context.Context, []prompt.Message, []Label) (ReadResult, error) {
+	return ReadResult{}, fmt.Errorf("ollama engine does not expose label log probabilities; use options.method generation")
+}
+
+func (c *OllamaClient) Generate(ctx context.Context, messages []prompt.Message) (GenRaw, error) {
+	keys := generationOptionKeys(messages)
+	if len(keys) < 2 {
+		return GenRaw{}, fmt.Errorf("ollama generation prompt has fewer than two options")
+	}
+	body := c.chatBody(messages)
+	body.Format = probabilitySchema(keys)
+	started := time.Now()
+	var parsed ollamaChatResponse
+	if err := c.post(ctx, "/api/chat", body, &parsed); err != nil {
+		return GenRaw{}, err
+	}
+	if strings.TrimSpace(parsed.Message.Content) == "" {
+		return GenRaw{}, fmt.Errorf("ollama returned an empty response")
+	}
+	// Structured output constrains the keys and numeric ranges, but models can
+	// still emit weights that do not add up to exactly one. Convert valid
+	// non-negative weights into a probability distribution before OpenJev's
+	// normal generation validator performs its strict contract checks.
+	if normalized, ok := normalizeProbabilityJSON(parsed.Message.Content, keys); ok {
+		parsed.Message.Content = normalized
+	}
+	totalMs := float64(time.Since(started).Microseconds()) / 1000
+	if parsed.TotalDuration > 0 {
+		totalMs = float64(parsed.TotalDuration) / float64(time.Millisecond)
+	}
+	return GenRaw{
+		Text:             parsed.Message.Content,
+		TotalMs:          totalMs,
+		PromptTokens:     parsed.PromptEvalCount,
+		CompletionTokens: parsed.EvalCount,
+	}, nil
+}
+
+func (c *OllamaClient) Health(ctx context.Context) (bool, error) {
+	var parsed struct {
+		Models []struct {
+			Name         string   `json:"name"`
+			Model        string   `json:"model"`
+			Capabilities []string `json:"capabilities"`
+		} `json:"models"`
+	}
+	if err := c.get(ctx, "/api/tags", &parsed); err != nil {
+		return false, err
+	}
+	for _, item := range parsed.Models {
+		if item.Name == c.model || item.Model == c.model {
+			if len(item.Capabilities) > 0 && !contains(item.Capabilities, "completion") {
+				return false, fmt.Errorf("ollama model %q does not have completion capability", c.model)
+			}
+			return true, nil
+		}
+	}
+	return false, fmt.Errorf("ollama model %q is not installed", c.model)
+}
+
+func contains(values []string, expected string) bool {
+	for _, value := range values {
+		if value == expected {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *OllamaClient) Warmup(ctx context.Context) error {
+	body := c.chatBody([]prompt.Message{{Role: "user", Content: "Reply with the single word ready."}})
+	var parsed ollamaChatResponse
+	if err := c.post(ctx, "/api/chat", body, &parsed); err != nil {
+		return err
+	}
+	if strings.TrimSpace(parsed.Message.Content) == "" {
+		return fmt.Errorf("ollama warmup returned no completion")
+	}
+	return nil
+}
+
+func (c *OllamaClient) chatBody(messages []prompt.Message) ollamaChatBody {
+	body := ollamaChatBody{
+		Model:     c.model,
+		Messages:  messages,
+		Stream:    false,
+		Think:     false,
+		KeepAlive: c.keepAlive,
+	}
+	body.Options.Temperature = 0
+	body.Options.NumCtx = c.numCtx
+	return body
+}
+
+func (c *OllamaClient) post(ctx context.Context, path string, body, dest any) error {
+	raw, err := json.Marshal(body)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.baseURL+path, bytes.NewReader(raw))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	return c.do(req, path, dest)
+}
+
+func (c *OllamaClient) get(ctx context.Context, path string, dest any) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.baseURL+path, nil)
+	if err != nil {
+		return err
+	}
+	return c.do(req, path, dest)
+}
+
+func (c *OllamaClient) do(req *http.Request, path string, dest any) error {
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		if c.log != nil {
+			prefix := raw
+			if len(prefix) > 500 {
+				prefix = prefix[:500]
+			}
+			c.log.Error("ollama request failed", "path", path, "status", resp.StatusCode, "body_prefix", string(prefix), "error", "non-success status")
+		}
+		return fmt.Errorf("ollama %s status %d", path, resp.StatusCode)
+	}
+	if dest == nil {
+		return nil
+	}
+	if err := json.Unmarshal(raw, dest); err != nil {
+		return fmt.Errorf("decode ollama %s response: %w", path, err)
+	}
+	return nil
+}
+
+func generationOptionKeys(messages []prompt.Message) []string {
+	var keys []string
+	for _, message := range messages {
+		if message.Role != "user" {
+			continue
+		}
+		for _, line := range strings.Split(message.Content, "\n") {
+			if len(line) < 4 || line[1] != '.' || line[2] != ' ' || line[0] < 'A' || line[0] > 'T' {
+				continue
+			}
+			keys = append(keys, line[:1]+": "+line[3:])
+		}
+	}
+	return keys
+}
+
+func probabilitySchema(keys []string) map[string]any {
+	properties := make(map[string]any, len(keys))
+	for _, key := range keys {
+		properties[key] = map[string]any{
+			"type":    "number",
+			"minimum": 0,
+			"maximum": 1,
+		}
+	}
+	return map[string]any{
+		"type":                 "object",
+		"properties":           properties,
+		"required":             keys,
+		"additionalProperties": false,
+	}
+}
+
+func normalizeProbabilityJSON(raw string, keys []string) (string, bool) {
+	var values map[string]float64
+	if err := json.Unmarshal([]byte(raw), &values); err != nil || len(values) != len(keys) {
+		return raw, false
+	}
+	total := 0.0
+	for _, key := range keys {
+		value, ok := values[key]
+		if !ok || value < 0 {
+			return raw, false
+		}
+		total += value
+	}
+	if total <= 0 {
+		return raw, false
+	}
+	normalized := make(map[string]float64, len(keys))
+	for _, key := range keys {
+		normalized[key] = values[key] / total
+	}
+	encoded, err := json.Marshal(normalized)
+	if err != nil {
+		return raw, false
+	}
+	return string(encoded), true
+}

