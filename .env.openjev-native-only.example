# MiniCPM-backed native OpenJev-only deployment profile.
# PowerShell does not load this file automatically;
# run-openjev-native-only.ps1 sets the selection variables before FastAPI starts.
INFERENCE_BACKEND=openjev
INFERENCE_BACKENDS=openjev
OPENJEV_URL=http://127.0.0.1:8090
CLASSIFICATION_CONFIG=config/classification.yaml
RETURN_CHUNK_DETAILS=false
LOG_TRANSCRIPTS=false
ENABLE_CONFIG_RELOAD=true
API_URL=http://127.0.0.1:8000
