+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/chat" {
+			t.Fatalf("path %s", r.URL.Path)
+		}
+		if err := json.NewDecoder(r.Body).Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		_, _ = w.Write([]byte(`{"message":{"content":"{\"A: Alpha\":0.75,\"B: Beta\":0.25}"},"prompt_eval_count":12,"eval_count":9,"total_duration":250000000}`))
+	}))
+	defer srv.Close()
+
+	messages := []prompt.Message{{Role: "user", Content: "Allowed options:\nA. Alpha\nB. Beta"}}
+	result, err := NewOllamaClient(srv.URL, "gemma4:e4b", "10m", 4096, 1, nil).Generate(context.Background(), messages)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Text != `{"A: Alpha":0.75,"B: Beta":0.25}` || result.PromptTokens != 12 || result.CompletionTokens != 9 || result.TotalMs != 250 {
+		t.Fatalf("result %+v", result)
+	}
+	if got["model"] != "gemma4:e4b" || got["stream"] != false || got["think"] != false {
+		t.Fatalf("request flags %+v", got)
+	}
+	format, ok := got["format"].(map[string]any)
+	if !ok || format["additionalProperties"] != false {
+		t.Fatalf("format %+v", got["format"])
+	}
+	required, ok := format["required"].([]any)
+	if !ok || len(required) != 2 || required[0] != "A: Alpha" || required[1] != "B: Beta" {
+		t.Fatalf("required %+v", format["required"])
+	}
+}
