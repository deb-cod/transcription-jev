# Local OpenJev decision API. No external API is used.
OPENJEV_URL=http://127.0.0.1:8090
OPENJEV_OLLAMA_SERVICE_URL=http://127.0.0.1:8091
OPENJEV_GEMMA_URL=http://127.0.0.1:8092
OPENJEV_METHOD=direct
OPENJEV_OLLAMA_URL=http://127.0.0.1:11434
OPENJEV_OLLAMA_MODEL=gemma4:e4b
INFERENCE_BACKEND=openjev
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
CLASSIFICATION_CONFIG=config/classification.yaml
RETURN_CHUNK_DETAILS=false
LOG_TRANSCRIPTS=false
ENABLE_CONFIG_RELOAD=true
API_URL=http://127.0.0.1:8000
