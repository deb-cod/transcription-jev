# Native Gemma-only deployment profile.
# PowerShell does not load this file automatically; run-gemma-only.ps1 sets
# the two selection variables before it launches FastAPI.
INFERENCE_BACKEND=openjev_gemma
INFERENCE_BACKENDS=openjev_gemma
OPENJEV_GEMMA_URL=http://127.0.0.1:8092
CLASSIFICATION_CONFIG=config/classification.yaml
RETURN_CHUNK_DETAILS=false
LOG_TRANSCRIPTS=false
ENABLE_CONFIG_RELOAD=true
API_URL=http://127.0.0.1:8000
